{
  "manifest_version": 3,
  "name": "AuthentiScan",
  "version": "2.0.0",
  "description": "Detect AI-generated content, deepfakes, and verify viral posts. Record your screen, take screenshots, or paste text for instant AI analysis.",
  "permissions": ["activeTab", "storage", "tabs", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
